rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /ratings/{tripId}/pois/{poiId} {
      allow read: if true;
      allow write: if request.auth.token.email in [
        'gerd.oberlechner@gmail.com',
        'impulse.ck@gmail.com',
        'luna.keim@icloud.com'
      ];
    }
  }
}
